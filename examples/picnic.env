# A single-purpose agent: groceries only, owner only.
# Paste into the Coolify resource's environment variables.
#
# Note what is absent — no executor, no GH_TOKEN. This resource has its own
# environment store, so those credentials are not merely unmapped here, they
# are not present in the container at all.

BUZZ_RELAY_DOMAIN=buzz.example.com
BUZZ_ACP_AGENT_OWNER=<your 64-char hex pubkey>
CLAUDE_CODE_OAUTH_TOKEN=<from `claude setup-token`>

# Default, but worth being explicit for an agent that can spend money.
BUZZ_ACP_RESPOND_TO=owner-only

# mcp-picnic is baked into the image, so credentials are all it needs. The
# username is the account's login email — putting the password here is the
# most common way to get "MCP error -32000: Connection closed".
PICNIC_USERNAME=you@example.com
PICNIC_PASSWORD=<password>
PICNIC_COUNTRY_CODE=NL
