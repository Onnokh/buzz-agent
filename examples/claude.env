# A general-purpose dev agent with the executor MCP and push access.
# Paste into the Coolify resource's environment variables.

BUZZ_RELAY_DOMAIN=buzz.example.com

# Persona: system prompt, model (opus) and respondTo (anyone) all come from
# the snapshot. Set BUZZ_ACP_MODEL or BUZZ_ACP_RESPOND_TO here to override one
# without editing it.
BUZZ_AGENT_SNAPSHOT=/etc/buzz/agents/claude.agent.json
BUZZ_ACP_AGENT_OWNER=<your 64-char hex pubkey>
CLAUDE_CODE_OAUTH_TOKEN=<from `claude setup-token`>

BUZZ_ACP_HEARTBEAT_INTERVAL=300

# Executor MCP, via the entrypoint's shorthand. The generic equivalent is
# MCP1_NAME=executor / MCP1_URL=... / MCP1_TOKEN=...
EXECUTOR_MCP_URL=https://executor.example.com/mcp
EXECUTOR_MCP_TOKEN=<bearer token, without the "Bearer " prefix>

# Lets the agent push.
GH_TOKEN=<classic PAT with repo scope>
GIT_USER_NAME=buzz-agent
GIT_USER_EMAIL=buzz-agent@users.noreply.github.com
