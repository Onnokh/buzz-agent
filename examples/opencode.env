# The same dev agent, on opencode Go + Kimi K2.7 instead of Claude Code.
# Paste into the Coolify resource's environment variables.

BUZZ_RELAY_DOMAIN=buzz.example.com

# Persona: the runtime (opencode) and the model (opencode-go/kimi-k2.7-code)
# come from the snapshot, along with the system prompt and respondTo.
BUZZ_AGENT_SNAPSHOT_URL=https://raw.githubusercontent.com/Onnokh/buzz-agent/main/agents/opencode.agent.json
BUZZ_ACP_AGENT_OWNER=<your 64-char hex pubkey>

# The whole login — your opencode Go key. opencode loads any models.dev provider
# whose declared env key is present, so there is nothing to run and no auth.json
# to persist. This one key covers two providers: `opencode-go` (the plan, via
# opencode.ai/zen/go) and `opencode` (Zen, per token). The model id picks which.
OPENCODE_API_KEY=<your opencode key>

# Overrides the snapshot's model. Provider-qualified, always: a bare "kimi" is
# ignored with a warning, and with no model at all opencode picks its own Zen
# default instead of the model you meant.
# BUZZ_ACP_MODEL=opencode-go/kimi-k3

# Same MCP slots as every other agent — the entrypoint writes them into
# opencode's config instead of Claude's.
MCP1_NAME=executor
MCP1_URL=https://executor.example.com/mcp
MCP1_TOKEN=<bearer token, with or without the "Bearer " prefix>
