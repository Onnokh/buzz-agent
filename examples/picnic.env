# A single-purpose agent: groceries only, owner only.
# Paste into the Coolify resource's environment variables.
#
# Note what is absent — no executor, no GH_TOKEN. This resource has its own
# environment store, so those credentials are not merely unmapped here, they
# are not present in the container at all.

BUZZ_RELAY_DOMAIN=buzz.example.com

# Persona: system prompt, model (sonnet) and respondTo (owner-only) come from
# the snapshot. The prompt is where "never order without an explicit yes" is
# written down, so read it before widening who this agent answers.
BUZZ_AGENT_SNAPSHOT=/etc/buzz/agents/picnic.agent.json
BUZZ_ACP_AGENT_OWNER=<your 64-char hex pubkey>
CLAUDE_CODE_OAUTH_TOKEN=<from `claude setup-token`>

# mcp-picnic in stdio slot 1. It is baked into the image; its published binary
# really is called `mcp-server-template`. The server reads these credentials
# from the inherited environment. The username is the account's login email —
# putting the password there is the most common way to get
# "MCP error -32000: Connection closed".
MCPS1_NAME=picnic
MCPS1_CMD=mcp-server-template
PICNIC_USERNAME=you@example.com
PICNIC_PASSWORD=<password>
PICNIC_COUNTRY_CODE=NL
