# A general-purpose dev agent with the executor MCP and push access.
# Paste into the Coolify resource's environment variables.

BUZZ_RELAY_DOMAIN=buzz.example.com

# Persona: system prompt, model (opus) and respondTo (anyone) all come from
# the snapshot. Set BUZZ_ACP_MODEL or BUZZ_ACP_RESPOND_TO here to override one
# without editing it.
BUZZ_AGENT_SNAPSHOT_URL=https://raw.githubusercontent.com/Onnokh/buzz-agent/main/agents/claude.agent.json
BUZZ_ACP_AGENT_OWNER=<your 64-char hex pubkey>
CLAUDE_CODE_OAUTH_TOKEN=<from `claude setup-token`>

BUZZ_ACP_HEARTBEAT_INTERVAL=300

# Executor MCP over HTTP, in slot 1.
MCP1_NAME=executor
MCP1_URL=https://executor.example.com/mcp
MCP1_TOKEN=<bearer token, with or without the "Bearer " prefix>

# Local shell and file tools, inside this container. Baked into the image but
# never registered by default: it is a capability, and defaulting it on would
# undo the point of giving each agent its own resource. Enabling it here lets
# the agent schedule things (`sleep 600 && buzz messages send ...`) and inspect
# its own environment — including the credentials below, since
# permission_mode is bypassPermissions. Reasonable for a dev agent that already
# has remote shell; do not copy it onto an agent that should not have it.
MCPS2_NAME=dev
MCPS2_CMD=buzz-dev-mcp

# Lets the agent push.
GH_TOKEN=<classic PAT with repo scope>
GIT_USER_NAME=buzz-agent
GIT_USER_EMAIL=buzz-agent@users.noreply.github.com
